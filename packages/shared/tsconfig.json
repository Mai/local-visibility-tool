{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Shared code runs in both Node and the browser, so it depends only on
    // globals both provide (URL). DOM supplies those types without pulling in
    // Node-specific ones.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
