{
  "name": "@sensi/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Audit backend: scoring engine, data collectors, PDF export",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@sensi/shared": "*",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "p-limit": "^7.3.1",
    "p-retry": "^8.0.0",
    "pdfkit": "^0.20.2",
    "playwright": "^1.62.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
