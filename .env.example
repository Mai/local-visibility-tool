# ---------------------------------------------------------------------------
# Senior Care Local SEO & GEO Evaluation Tool — environment template
# Copy to .env and fill in. Every service below has a free tier; total cost $0.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Google Places API ----------------------------------------------------
# console.cloud.google.com -> enable "Places API (New)" -> create an API key.
# IMPORTANT: set a $0 budget alert in Google Cloud Console right after you
# create the key so you get an email before any charge could occur.
# Used for: Google Business Profile data, reviews, competitor discovery.
GOOGLE_PLACES_API_KEY=

# --- Google PageSpeed Insights -------------------------------------------
# Works with no key at a low quota. A key (same Cloud project, enable
# "PageSpeed Insights API") raises the quota. Optional.
PAGESPEED_API_KEY=

# --- Serper.dev -----------------------------------------------------------
# serper.dev -> sign up -> copy key. Free tier: 2,500 searches/month.
# Used for: Google SERP results, citation fallback checks (site: queries).
SERPER_API_KEY=

# --- Yelp Fusion ----------------------------------------------------------
# yelp.com/developers -> create app -> copy API key. Free: 5,000 calls/day.
YELP_API_KEY=

# --- Scraping / caching behaviour -----------------------------------------
# Cache scraped + API results for 24h (seconds) to avoid redundant requests.
CACHE_TTL_SECONDS=86400
# Where the on-disk cache lives (relative paths resolve from the repo root).
CACHE_DIR=.cache
# Set to false to let Playwright run with a visible browser while debugging.
PLAYWRIGHT_HEADLESS=true
# Hard ceiling for a single scrape, in milliseconds.
SCRAPE_TIMEOUT_MS=20000
# Honour robots.txt when scraping (leave true).
RESPECT_ROBOTS_TXT=true

# --- Frontend -------------------------------------------------------------
# Read by the Next.js app in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
